# =====================================================================
# LIFE RPG - ENVIRONMENT CONFIGURATION
# =====================================================================
# Copy this file to `.env` or `.env.local` to enable Supabase persistence.
# If these variables are left empty, the application automatically runs
# in full offline Demo Mode with complete local state persistence!
# =====================================================================

# Supabase Project URL (from your Supabase Project Settings -> API)
VITE_SUPABASE_URL=https://your-project.supabase.co

# Supabase Public Anonymous API Key (Project Settings -> API -> anon public)
VITE_SUPABASE_ANON_KEY=your-anon-key-here
