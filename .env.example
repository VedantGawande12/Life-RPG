# Life RPG - Environment Configuration
# Copy this file to .env and fill in your Supabase project credentials.
# If these are not provided, Life RPG runs smoothly in Zero-Config Demo Mode with offline state persistence!

VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here
